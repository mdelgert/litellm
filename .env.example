# =============================================================
#  LiteLLM Docker Compose – Environment Variables
#  Copy this file to .env and fill in the values.
#  NEVER commit the real .env to source control.
# =============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=litellm
POSTGRES_USER=litellm
# REQUIRED – use a strong random password
# Linux/macOS (URL-safe, .env-safe): openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 40; echo
POSTGRES_PASSWORD=change_me_strong_password

# ── Redis ────────────────────────────────────────────────────
# REQUIRED – use a strong random password
# Linux/macOS (URL-safe, .env-safe): openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 40; echo
REDIS_PASSWORD=change_me_redis_password
# Max memory Redis may use (e.g. 256mb, 512mb, 1gb)
REDIS_MAXMEMORY=256mb

# ── LiteLLM Core ─────────────────────────────────────────────
# Pin the LiteLLM image to a specific stable release.
LITELLM_IMAGE_TAG=v1.97.0

# REQUIRED – master key for the proxy API (prefix with "sk-")
# Linux/macOS (URL-safe, .env-safe): echo "sk-$(openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 40)"
LITELLM_MASTER_KEY=sk-change_me_master_key

# Port exposed on the host
LITELLM_PORT=4000

# Log level: DEBUG | INFO | WARNING | ERROR
LITELLM_LOG=INFO

# Set to true to skip writing spend logs (useful in high-traffic envs)
DISABLE_SPEND_LOGS=false

# ── LiteLLM UI ───────────────────────────────────────────────
LITELLM_UI_USERNAME=admin
# REQUIRED – password for the built-in UI
# Linux/macOS (URL-safe, .env-safe): openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 40; echo
LITELLM_UI_PASSWORD=change_me_ui_password

# Azure OpenAI (if used)
AZURE_API_KEY=
AZURE_API_BASE=https://YOUR_RESOURCE.openai.azure.com/
AZURE_API_VERSION=2024-02-01

# ── LLM Provider Keys (add only what you use) ────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# COHERE_API_KEY=
